# Secrets. A .gitignore only covers its OWN directory and below, so this must
# live at the repo root to protect temp/.env and ignore the output dirs.
.env
temp/.env

__pycache__/
.DS_Store

# Raw API dumps. Kept as the compressed archive paper/out/raw.tar.xz, which IS
# tracked; the uncompressed tree is not.
out/raw/
paper/out/raw/

# records.csv is kept as a compressed archive rather than as a 48 MB CSV.
paper/out/*.zip
!paper/out/records.csv.zip

# Method record md file mostly for Claude and me to track the progress. 
# Should not be published, but not a secret either.
PIPELINE_CONTROL.md